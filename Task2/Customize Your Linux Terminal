print_content() {
    ls -l
}

go_to() {
    cd "$1" || echo "Error: directory not found"
}

search() {
    grep --color=always -n "$1" "$2"
}

show_file() {
    cat -n "$1"
}

remove() {
    read -p "Are you sure you want to delete '$1'? (y/n): " confirm
    if [ "$confirm" = "y" ]; then
        rm "$1"
        echo "'$1' deleted."
    else
        echo "Cancelled."
    fi
}

make_dir() {
    mkdir -p "$1"
}

create_file() {
    touch "$1"
}
