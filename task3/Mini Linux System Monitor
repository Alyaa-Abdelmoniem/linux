
#!/bin/bash

while true
do
    echo "====================="
    echo "Linux Toolkit"
    echo "====================="
    echo "1) Show Date"
    echo "2) Show Uptime"
    echo "3) Show Logged Users"
    echo "4) Show Current Directory"
    echo "5) Show Disk Usage"
    echo "6) Show Memory Usage"
    echo "7) List Files"
    echo "8) Exit"

    read -p "Choose an option: " choice

    case $choice in
        1) date ;;
        2) uptime ;;
        3) who ;;
        4) pwd ;;
        5) df -h ;;
        6) free -h ;;
        7) ls ;;
        8) echo "Goodbye"; break ;;
        *) echo "Invalid option" ;;
    esac

    echo
done
