#!/bin/bash

read -s -p "Enter password: " password
echo ""

length_ok="Missing"
upper_ok="Missing"
lower_ok="Missing"
digit_ok="Missing"
special_ok="Missing"

score=0

if [ "${#password}" -ge 8 ]; then
    length_ok="OK"
    ((score++))
fi

if [[ "$password" =~ [A-Z] ]]; then
    upper_ok="OK"
    ((score++))
fi

if [[ "$password" =~ [a-z] ]]; then
    lower_ok="OK"
    ((score++))
fi

if [[ "$password" =~ [0-9] ]]; then
    digit_ok="OK"
    ((score++))
fi

if [[ "$password" =~ [^a-zA-Z0-9] ]]; then
    special_ok="OK"
    ((score++))
fi

if [ "$score" -eq 5 ]; then
    overall="Strong"
elif [ "$score" -ge 3 ]; then
    overall="Medium"
else
    overall="Weak"
fi

echo ""
echo "Password Strength Report"
echo ""
printf "Length          : %s\n" "$length_ok"
printf "Uppercase       : %s\n" "$upper_ok"
printf "Lowercase       : %s\n" "$lower_ok"
printf "Digit           : %s\n" "$digit_ok"
printf "Special Char    : %s\n" "$special_ok"
echo ""
echo "Overall: $overall"
