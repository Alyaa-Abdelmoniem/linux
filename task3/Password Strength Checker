
#!/bin/bash

read -sp "Enter Password: " password
echo
echo

echo "Password Strength Report"
echo

if [ ${#password} -ge 8 ]; then
    echo "Length          : OK"
else
    echo "Length          : Missing"
fi

if [[ $password =~ [A-Z] ]]; then
    echo "Uppercase       : OK"
else
    echo "Uppercase       : Missing"
fi

if [[ $password =~ [a-z] ]]; then
    echo "Lowercase       : OK"
else
    echo "Lowercase       : Missing"
fi

if [[ $password =~ [0-9] ]]; then
    echo "Digit           : OK"
else
    echo "Digit           : Missing"
fi

if [[ $password =~ [^a-zA-Z0-9] ]]; then
    echo "Special Char    : OK"
else
    echo "Special Char    : Missing"
fi

if [[ ${#password} -ge 8 && $password =~ [A-Z] && $password =~ [a-z] && $password =~ [0-9] && $password =~ [^a-zA-Z0-9] ]]; then
    echo
    echo "Overall: Strong"
else
    echo
    echo "Overall: Weak"
fi
